; Shimla Rising -- Godot 4.7 project
;
; Ye Unreal Engine ki jagah hai. Wajah: Godot MIT licensed hai, download sirf
; ~120 MB (UE 120 GB), aur iski scene files (.tscn) + GDScript plain TEXT hain --
; isliye poora project git mein padha, likha aur review kiya ja sakta hai.
;
; PEHLE YE CHALAO:  python tools/sync_godot_data.py
; (shared data/ folder ko godot/data/ mein copy karta hai, kyunki Godot res:// ke
;  bahar se shipped files nahi padh sakta)

config_version=5

[application]

config/name="Shimla Rising"
config/description="Shimla par based open-world action game. Web build (Three.js) ke saath ek hi data layer share karta hai."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://scripts/input_setup.gd"
GameData="*res://scripts/game_data.gd"
Geo="*res://scripts/geo.gd"
MissionManager="*res://scripts/mission_manager.gd"
SaveGame="*res://scripts/save_game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.42, 0.56, 0.70, 1)
anti_aliasing/quality/msaa_3d=2
